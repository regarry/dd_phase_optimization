#!/bin/bash
#BSUB -n 4
#BSUB -W 2:00 # bme_gpu max 335:00 hr or 2 weeks
#BSUB -R "rusage[mem=4GB]"
#BSUB -q bme_gpu
#BSUB -gpu "num=3:mode=exclusive_process:mps=yes"
#BSUB -R "select[l40s]"
#BSUB -J train_dd
#BSUB -o ./logs/.%J
#BSUB -e ./logs/.%J

hostname
nvidia-smi
#nvidia-smi -q -d ECC
#nvidia-smi --query-gpu=index,name,ecc.errors.uncorrectable.aggregate,memory.total,utilization.gpu --format=csv
#nvidia-smi topo -m

if [[ -n "${DD_MODULES:-}" ]]; then
    read -r -a DD_MODULE_NAMES <<< "$DD_MODULES"
    module load "${DD_MODULE_NAMES[@]}"
fi
#export CUDA_LAUNCH_BLOCKING=1

# Get the unique config file path from the first argument
CONFIG_FILE="__CONFIG_FILE__"

echo "Job is running with config file: $CONFIG_FILE"
echo "--- Config Contents ---"
cat $CONFIG_FILE
echo "-----------------------"
"${DD_PYTHON:-python}" -u -m training.training --config "$CONFIG_FILE"

# Optional: Clean up the copied config file
echo "Cleaning up $CONFIG_FILE"
rm $CONFIG_FILE
