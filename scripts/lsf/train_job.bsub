hostname
nvidia-smi
#nvidia-smi -q -d ECC
#nvidia-smi --query-gpu=index,name,ecc.errors.uncorrectable.aggregate,memory.total,utilization.gpu --format=csv
#nvidia-smi topo -m

module load conda
module load cuda/12.3
#export CUDA_LAUNCH_BLOCKING=1
#conda activate /rsstu/users/a/agrinba/DeepDesign/deepdesign

# Get the unique config file path from the first argument
CONFIG_FILE="__CONFIG_FILE__"

echo "Job is running with config file: $CONFIG_FILE"
echo "--- Config Contents ---"
cat $CONFIG_FILE
echo "-----------------------"
#cd /rsstu/users/a/agrinba/DeepDesign/deepdesign
conda run -p /rsstu/users/a/agrinba/DeepDesign/deepdesign python ./training/training.py --config $CONFIG_FILE

# Optional: Clean up the copied config file
echo "Cleaning up $CONFIG_FILE"
rm $CONFIG_FILE
